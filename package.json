{
  "name": "ai-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc -p worker",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --project unit --project integration",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts.tmp && mv src/lib/supabase/database.types.ts.tmp src/lib/supabase/database.types.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test:all && pnpm build",
    "test:smoke": "vitest run --project smoke"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/openai": "4.0.96",
    "@fontsource-variable/inter": "5.3.0",
    "@hyperframes/core": "0.8.134",
    "@hyperframes/player": "0.8.134",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compromise": "14.19.0",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "geist": "^1.8.1",
    "gsap": "3.15.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^1.59.0",
    "mammoth": "1.13.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pdfkit": "0.20.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unified": "11.0.5",
    "unpdf": "1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
