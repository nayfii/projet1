# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: never put a secret in them.

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the app (used in magic links, invitations and OAuth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default UI language when the browser language is neither French nor English (fr or en).
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# ─── Supabase (EU region in production) ──────────────────────────────────────
# Project URL. Local: printed by `supabase start` (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…): safe in the browser, every access is filtered by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): bypasses RLS. Server only, used by a few audited modules and the render worker.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string (migrations, tests and the render worker job queue).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Authentication ──────────────────────────────────────────────────────────
# Shows the "Continue with Google" button. Set to true only once Google sign-in is configured in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Google sign-in: OAuth client created in Google Cloud Console (configured in Supabase Auth).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# SMTP server for magic links and invitations (Supabase's built-in mailer is for testing only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown in emails, e.g. "Workspace <no-reply@yourdomain.com>".
SMTP_SENDER=

# ─── AI providers ────────────────────────────────────────────────────────────
# Each key is optional: without it, that provider's models appear as "Not configured".
# Models, price estimates and credit rates live in the database (Platform console → Models and pricing).
# OpenAI API key (ChatGPT models; also embeddings if EMBEDDINGS_PROVIDER=openai).
OPENAI_API_KEY=
# Anthropic API key (Claude models).
ANTHROPIC_API_KEY=
# Google Gemini API key from a billing-enabled project (the free tier allows Google to use data).
GOOGLE_GENERATIVE_AI_API_KEY=
# Image model that turns a photo into a personal 3D avatar (OpenAI, uses OPENAI_API_KEY). Default: gpt-image-1.5.
AVATAR_IMAGE_MODEL=gpt-image-1.5
# Images in the chat (create or change a picture): ChatGPT's image model at OpenAI (uses OPENAI_API_KEY).
CHAT_IMAGE_MODEL=chatgpt-image-latest
# Speech-to-text model for voice dictation in the chat (OpenAI, uses OPENAI_API_KEY). Default: gpt-4o-transcribe.
DICTATION_MODEL=gpt-4o-transcribe

# Knowledge import: tutorial video shown above the import (https address of a video file, or a YouTube /
# Vimeo link). Empty: a placeholder is shown; the import works without it.
IMPORT_TUTORIAL_VIDEO_URL=

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Which provider builds the search index of documents and memory: openai or google.
EMBEDDINGS_PROVIDER=openai
# Embeddings model name for that provider (default: text-embedding-3-small, or gemini-embedding-001 for google).
# Vectors always have 1536 numbers (database schema). After a change of provider or model, older documents
# are found by their words only until they are added again.
EMBEDDINGS_MODEL=text-embedding-3-small

# ─── Hide (sensitive data protection) ────────────────────────────────────────
# Secret (at least 32 characters) that encrypts the real values behind placeholders such as [IBAN_1]
# and gives each value a stable placeholder. Required for Hide. Generate: openssl rand -base64 32
# Keep it safe: changing or losing it makes earlier conversations' placeholders impossible to restore.
# Person names are detected by a library bundled with the app: no model download, no external service.
HIDE_ENCRYPTION_KEY=

# ─── Render worker (video and motion design) ─────────────────────────────────
# These go to the worker container (worker/README.md), not to the web app.
# SUPABASE_URL: the project URL (same value as NEXT_PUBLIC_SUPABASE_URL).
# SUPABASE_SECRET_KEY: the secret key above (the worker reads the queue and saves the videos).
# How often the worker checks for new jobs, in milliseconds (default 2000).
RENDER_POLL_MS=2000
# Longest a single render may take, in milliseconds (default 15 minutes).
RENDER_JOB_TIMEOUT_MS=900000

# ─── Platform bootstrap ──────────────────────────────────────────────────────
# Email(s) of our team granted platform admin rights at first start (comma-separated). They never get access to customer content.
PLATFORM_ADMIN_EMAILS=

# ─── Tests only ──────────────────────────────────────────────────────────────
# When "true", every AI provider is replaced by a simulated one (answers start with "[TEST]" and the
# chat shows a test-mode notice). For automated tests only: never enable in production.
AI_FAKE_PROVIDER=false
# Speed tests only (with AI_FAKE_PROVIDER=true): how long the simulated transcription and polish wait,
# in milliseconds (docs/DICTATION.md). Ignored otherwise.
DICTATION_FAKE_LATENCY_MS=0

# ─── Versions and Claude Code from our console (Platform → Versions, Aperçu, Debug) ──
# A fine-grained GitHub token for this repository only (Actions, Contents, Pull requests and Workflows:
# read and write). Lets the console launch versions, start checks, and accept Claude Code's changes.
GITHUB_RELEASE_TOKEN=
# Defaults shown; change only if the repository or the branches change.
GITHUB_REPOSITORY=nayfii/projet1
RELEASE_SOURCE_BRANCH=claude/amazing-davinci-5th459
RELEASE_BRANCH=production

# Integrations (V1.1, docs/INTEGRATIONS.md): key that encrypts connected apps' tokens (32+ characters,
# generate with `openssl rand -base64 48`; never change it once connections exist), then each provider's
# OAuth client registered by our team. Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/integrations/<provider>/callback
INTEGRATIONS_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
CANVA_OAUTH_CLIENT_ID=
CANVA_OAUTH_CLIENT_SECRET=
# HubSpot is shown "Bientôt" (coming soon) in V1.1: no connection is offered yet.
# HUBSPOT_OAUTH_CLIENT_ID=
# HUBSPOT_OAUTH_CLIENT_SECRET=

# Workflows' clock (V1.1, docs/WORKFLOWS.md): protects /api/cron/workflows. Vercel Cron sends it
# automatically; the GitHub workflow "Workflows tick" needs the same value as a secret.
CRON_SECRET=
# The production address, as GitHub repository variable APP_URL (not here): used by "Workflows tick"
# (every 5 minutes) and "Uptime" (every 10 minutes, /api/health; a failed run e-mails an alert).
